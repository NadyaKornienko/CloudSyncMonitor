    "syncState.message.offline": {
      "comment": "Banner: no network path; local edits queued",
      "extractionState": "manual",
      "localizations": {
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Sou fora de línia. Els vostres canvis es desen localment i se sincronitzaran quan torneu a estar en línia."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du er offline. Dine ændringer gemmes lokalt og synkroniseres, når du er online igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du bist offline. Deine Änderungen werden lokal gespeichert und synchronisiert, sobald du wieder online bist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You're offline. Your changes are saved locally and will sync when you're back online."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "You're offline. Your changes are saved locally and will sync when you're back online."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estás sin conexión. Tus cambios se guardan localmente y se sincronizarán cuando vuelvas a estar en línea."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Estás sin conexión. Tus cambios se guardan localmente y se sincronizarán cuando vuelvas a estar en línea."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Olet offline-tilassa. Muutoksesi tallennetaan paikallisesti ja synkronoidaan, kun olet taas verkossa."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Offline ka. Naka-save nang lokal ang mga pagbabago mo at mag-sync sila kapag bumalik ka online."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous êtes hors ligne. Vos modifications sont enregistrées localement et seront synchronisées dès votre retour en ligne."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous êtes hors ligne. Vos modifications sont enregistrées localement et seront synchronisées dès votre retour en ligne."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sei offline. Le tue modifiche sono salvate localmente e verranno sincronizzate quando tornerai online."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オフラインです。変更はローカルに保存され、オンラインに戻ったときに同期されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오프라인 상태입니다. 변경 사항은 로컬에 저장되며, 다시 온라인이 되면 동기화됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je bent offline. Je wijzigingen worden lokaal opgeslagen en gesynchroniseerd zodra je weer online bent."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jesteś offline. Twoje zmiany są zapisywane lokalnie i zostaną zsynchronizowane po powrocie do trybu online."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você está offline. Suas alterações são salvas localmente e serão sincronizadas quando você ficar online novamente."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Está offline. As suas alterações são guardadas localmente e serão sincronizadas quando voltar a estar online."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы офлайн. Изменения сохраняются локально и синхронизируются при появлении сети."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du är offline. Dina ändringar sparas lokalt och synkroniseras när du är online igen."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çevrimdışısınız. Değişiklikleriniz yerel olarak kaydediliyor ve tekrar çevrimiçi olduğunuzda eşzamanlanacak."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ви офлайн. Зміни зберігаються локально та синхронізуються, коли ви знову будете онлайн."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
